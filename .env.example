# ==============================================================================
# AI Mitra Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file with real secrets to version control.
# ==============================================================================

# Google Gemini API Key (Required for AI brain, summarization & tutor engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Telegram Bot Token (Required from @BotFather for Telegram notifications & chat)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Allowed Telegram User IDs (Comma-separated integer user IDs allowed to interact with the bot)
# Example: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=your_telegram_user_id_here

# Timezone for daily schedule (Default: Asia/Kolkata for IST)
TIMEZONE=Asia/Kolkata

# Daily Digest Schedule Time (24-hour format HH:MM, Default: 08:00)
SCHEDULE_TIME=08:00

# SQLite Database path (Stored in local data directory outside public web paths)
DATABASE_PATH=data/ai_mitra.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

